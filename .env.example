# Optional local signaling. Leave all unset to use PeerServer Cloud.
# Copy to .env.local, start npm run signaling, then restart Vite.
# These defaults match the signaling script. For a custom server port/path, also
# pass PEER_PORT / PEER_PATH to npm run signaling; Node does not read this file.
# VITE_PEER_HOST=127.0.0.1
# VITE_PEER_PORT=9000
# VITE_PEER_SECURE=false
# VITE_PEER_PATH=/peerjs

# Optional public STUN URLs only; comma-separated. Never put private keys here.
# This overrides PeerJS defaults, including its public TURN fallback.
# VITE_ICE_URLS=stun:stun.l.google.com:19302
